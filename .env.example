# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_DB=bookingai
POSTGRES_USER=bookingai
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
DATABASE_URL=postgresql://bookingai:CHANGE_ME_strong_password_here@postgres:5432/bookingai

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Auth (generate SECRET_KEY with: openssl rand -hex 32) ──────────────────
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Admin Account (seeded once on first startup) ────────────────────────────
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=CHANGE_ME_strong_password
ADMIN_NAME=Admin

# ─── Bolna AI ────────────────────────────────────────────────────────────────
# API key used for calling Bolna API and for validating inbound function tool calls
BOLNA_API_KEY=
# Webhook secret for verifying Bolna webhook signatures (set in Bolna dashboard)
BOLNA_WEBHOOK_SECRET=
# Agent IDs from Bolna dashboard (Settings > Agents)
BOLNA_REMINDER_AGENT_ID=
BOLNA_RENEWAL_AGENT_ID=
BOLNA_LEAD_AGENT_ID=
BOLNA_INBOUND_AGENT_ID=
# The phone number assigned to your inbound agent in Bolna
BOLNA_INBOUND_PHONE=
# Default location UUID — used by inbound calls when no location_id is provided
DEFAULT_LOCATION_ID=

# ─── WhatsApp Business Cloud API ─────────────────────────────────────────────
# Get these from Meta Developer Console > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Any random string — used to verify Meta's webhook handshake
WHATSAPP_VERIFY_TOKEN=

# ─── Google Calendar ─────────────────────────────────────────────────────────
# Paste the entire contents of your service account JSON key (no line breaks)
GOOGLE_CALENDAR_CREDENTIALS_JSON=
# The calendar ID to sync appointments to (usually your-email@gmail.com)
GOOGLE_CALENDAR_ID=

# ─── Optional ────────────────────────────────────────────────────────────────
SENTRY_DSN=
